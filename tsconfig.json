{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["esnext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true,
    "declaration": true,
    "esModuleInterop": true
  },
  "include": ["src", "test", "vitest.config.ts"],
  "exclude": ["node_modules", "build", "dist", "example", "rollup.config.js"]
}
